# Plantilla de configuracion de una sede.
# Copia este fichero a sites/<sede>.env y ajusta los valores.
# SITE_ID debe ser uno de: central, chamartin, atocha

SITE_ID=<central|chamartin|atocha>

# Puertos publicados en el host. Valores distintos por sede
# si levantas varias sedes en la misma maquina.
SITE_API_PORT=8000
POSTGRES_PORT=5432

# Base de datos (credenciales de desarrollo)
POSTGRES_DB=pids
POSTGRES_USER=pids
POSTGRES_PASSWORD=changeme

# Kafka / simulacion realtime
KAFKA_TOPIC=taxi-trips
ACCELERATION_FACTOR=60

# Version de Spark (debe coincidir con pyspark en requirements.txt)
SPARK_VERSION=4.2.0

# Coordinador (profile 'coordinator', issue #59). Puerto publicado en
# el host: 8100 central, 8101 chamartin, 8102 atocha.
COORDINATOR_PORT=8100

# Opcionales: solo si las sedes estan en maquinas distintas y no
# comparten la red docker 'pids-interconnect'. Por defecto el
# coordinador usa http://site-api-<sede>:8000 dentro de esa red.
# INTERCONNECT_NETWORK=pids-interconnect
# SITE_API_URL_CENTRAL=http://<host-central>:8000
# SITE_API_URL_CHAMARTIN=http://<host-chamartin>:8001
# SITE_API_URL_ATOCHA=http://<host-atocha>:8002
