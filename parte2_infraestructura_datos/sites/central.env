# Sede: central
SITE_ID=central

# Puertos publicados en el host (distintos por sede para no colisionar)
SITE_API_PORT=8000
POSTGRES_PORT=5432

# Base de datos (credenciales de desarrollo)
POSTGRES_DB=pids
POSTGRES_USER=pids
POSTGRES_PASSWORD=pids

# Kafka / simulacion realtime
KAFKA_TOPIC=taxi-trips
ACCELERATION_FACTOR=60

# Version de Spark (debe casar con pyspark de requirements.txt)
SPARK_VERSION=4.2.0

# Puerto de metricas Prometheus del producer (issue #65)
PRODUCER_METRICS_PORT=9000
