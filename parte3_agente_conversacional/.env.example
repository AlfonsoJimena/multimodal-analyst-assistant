# ======================================================================
# Parte 3 - agente conversacional. Copia este fichero a .env y rellena.
# El .env real NO se sube al repo (lo ignora el .gitignore raiz).
# ======================================================================

# --- LLM (OpenRouter, API compatible con OpenAI) ---
# Clave del equipo en OpenRouter. Pidesela a quien la creo (P3-08).
OPENROUTER_API_KEY=sk-or-...
# Modelos PROVISIONALES. La eleccion definitiva se decide en P3-08/P3-16.
LLM_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODEL=google/gemini-flash-1.5
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=30
MAX_TOOL_ROUNDS=5

# --- Coordinador de la parte 2 ---
# En orden de failover: central -> chamartin -> atocha.
# Local:  http://localhost:8100,http://localhost:8101,http://localhost:8102
# Docker: http://central-coordinator:8000,http://chamartin-coordinator:8000,http://atocha-coordinator:8000
# Mock:   http://localhost:8190
COORDINATOR_URLS=http://localhost:8100,http://localhost:8101,http://localhost:8102
COORDINATOR_TIMEOUT_S=10

# --- Privacidad ---
# Celdas con menos de este numero de viajes se ocultan.
MIN_TRIPS_PER_CELL=5

# --- API del agente / interfaz ---
# Token entre la interfaz y la API. Vacio = sin token (modo desarrollo).
AGENT_API_TOKEN=
# URL de la API del agente, que usa la interfaz (Streamlit).
AGENT_API_URL=http://localhost:8300
# Turnos de historial que recuerda cada sesion.
MAX_HISTORY_TURNS=6
